{
  "manifest_version": 3,
  "name": "TTEA Application Assistant",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "description": "Manually review TTEA opportunities in a persistent side panel.",
  "permissions": ["sidePanel", "tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {"default_title": "Open TTEA Application Assistant"},
  "background": {"service_worker": "service-worker.js"},
  "side_panel": {"default_path": "sidepanel.html"}
}
